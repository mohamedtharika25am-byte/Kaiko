<?xml version="1.0" encoding="utf-8"?>
<!--
    App Widget Provider Info for Kaiko 1x1 Emergency SOS Trigger Widget
    - minWidth/minHeight: 40dp (fits a standard 1x1 cell grid on launcher)
    - updatePeriodMillis: 0 (no periodic background update needed, event-driven tap)
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialKeyguardLayout="@layout/widget_layout"
    android:initialLayout="@layout/widget_layout"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/ic_sos"
    android:resizeMode="none"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
