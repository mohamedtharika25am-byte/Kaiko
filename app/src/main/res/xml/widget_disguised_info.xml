<?xml version="1.0" encoding="utf-8"?>
<!--
    App Widget Provider Info for Kaiko Disguised (Daily Memo) Widget
    - minWidth/minHeight: 40dp x 40dp
    - Neutral preview image and label
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialKeyguardLayout="@layout/widget_disguised_layout"
    android:initialLayout="@layout/widget_disguised_layout"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/ic_memo"
    android:resizeMode="none"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard" />
