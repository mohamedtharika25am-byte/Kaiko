<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Guardian Index (BLUE: Heading/Slot indicator) -->
    <TextView
        android:id="@+id/tvGuardianSlot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Guardian 1" />

    <!-- Name (Optional: Only visible if not blank, Never "Unknown") -->
    <TextView
        android:id="@+id/tvGuardianName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="👤 John Doe"
        tools:visibility="visible" />

    <!-- Relation (GREY: Metadata) -->
    <TextView
        android:id="@+id/tvGuardianRelation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Father"
        tools:visibility="visible" />

    <!-- Phone Number Row with 👤+ Action Icon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvGuardianPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/btnChangeContact"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="9876543210" />

        <!-- 👤+ Icon Action: opens Contacts picker to change guardian contact -->
        <ImageButton
            android:id="@+id/btnChangeContact"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Change Guardian from Contacts"
            android:padding="4dp"
            android:src="@drawable/ic_person_add" />

    </RelativeLayout>

    <!-- Row 1: 📞 Call & 💬 Message (BLUE actions) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCall"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline"
            android:text="📞  Call"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMessage"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline"
            android:text="💬  Message"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Remove Guardian Action (RED text for removal) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRemove"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:text="Remove Guardian"
        android:textColor="@color/emergency_red"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
