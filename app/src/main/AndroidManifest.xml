<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 
        ========================================================================
        PERMISSIONS & RATIONALE
        ========================================================================
    -->

    <!-- 
        1. SEND_SMS: Required to send the emergency text message containing the user's
           location and distress message directly to the registered guardian's phone number.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- 
        2. ACCESS_FINE_LOCATION: Required to query high-accuracy GPS coordinates (latitude, 
           longitude) using FusedLocationProviderClient when an emergency trigger fires.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 
        3. ACCESS_COARSE_LOCATION: Required as a companion/fallback location permission
           to fetch approximate cellular/Wi-Fi location if GPS lock is slow or indoors.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 
        4. POST_NOTIFICATIONS: Required on Android 13 (API level 33) and above to display
           the confirmation system notification confirming that the help alert was dispatched.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 
        5. VIBRATE: Optional tactile feedback when the emergency trigger is successfully activated.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kaiko">

        <!-- 
            ====================================================================
            1. ONBOARDING & SETUP ACTIVITY
            ====================================================================
            Single activity allowing the user to configure guardian phone number,
            grant runtime permissions, and check/enable Accessibility Service.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 
            ====================================================================
            2. HARDWARE BUTTON LISTENER ACCESSIBILITY SERVICE
            ====================================================================
            Monitors hardware volume down key events globally (even with screen locked/off).
            Protected with BIND_ACCESSIBILITY_SERVICE permission so only system can bind.
        -->
        <service
            android:name=".KaikoAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/accessibility_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 
            ====================================================================
            3. HOME SCREEN SOS WIDGET RECEIVER
            ====================================================================
            AppWidgetProvider handling 1x1 home screen widget updates and single-tap
            SOS trigger broadcasts.
        -->
        <receiver
            android:name=".KaikoWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.yourname.kaiko.ACTION_TRIGGER_WIDGET" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

    </application>

</manifest>
